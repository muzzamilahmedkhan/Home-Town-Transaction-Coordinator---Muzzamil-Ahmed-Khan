---
import Layout from '../layouts/Layout.astro';
import App from '../App';
import { DEMO_BLOG_POSTS, CATEGORY_ARCHIVE_CONFIGS } from '../data/blog';
import { RESOURCE_LIBRARY_ITEMS, getResourceBySlug } from '../data/resourceLibraryData';

export async function getStaticPaths() {
  const routes = [
    'how-htc-works',
    'how-it-works',
    'why-htc',
    'pricing',
    'services-and-pricing',
    'services',
    'listing-coordination',
    'contract-to-close-services',
    'contract-to-close',
    'transaction-coordination',
    'transaction-coordinator-for-realtors',
    'agent-business-calculator',
    'about',
    'team',
    'meet-the-tribe',
    'who-we-support',
    'miami-transaction-coordinator',
    'miami-dade-transaction-coordinator',
    'broward-transaction-coordinator',
    'south-florida-transaction-coordinator',
    'faq',
    'book',
    'book-discovery-call',
    'book-call',
    'submit-deal',
    'reviews',
    'resources',
    'blog',
    'tcworkshop',
    'resources/free-guides-downloads',
    'free-guides-downloads',
    'resources/guides',
    'guides'
  ];

  const blogRoutes = DEMO_BLOG_POSTS.map(post => `resources/${post.slug}`);
  const blogRoutesAlt = DEMO_BLOG_POSTS.map(post => `blog/${post.slug}`);
  const categoryRoutes = Object.keys(CATEGORY_ARCHIVE_CONFIGS).map(slug => `resources/${slug}`);

  // Dynamic Resource Library routes for each individual resource
  const resourceRoutes = RESOURCE_LIBRARY_ITEMS.map(
    item => `resources/free-guides-downloads/${item.slug}`
  );
  const resourceRoutesAlt = RESOURCE_LIBRARY_ITEMS.map(
    item => `free-guides-downloads/${item.slug}`
  );

  const allSlugs = [...routes, ...blogRoutes, ...blogRoutesAlt, ...categoryRoutes, ...resourceRoutes, ...resourceRoutesAlt];

  return allSlugs.map(slug => {
    let title = "Hometown TC | Boutique Real Estate Support Agency for Florida Realtors";
    let description = "Boutique real estate support for Florida Realtors — from Listing Launch to Contract-to-Close and Post-Close. South Florida-founded, serving statewide.";

    if (slug === 'resources/free-guides-downloads' || slug === 'free-guides-downloads' || slug === 'resources/guides' || slug === 'guides') {
      title = "Free Real Estate Tools, Guides & Templates | Hometown TC";
      description = "Free tools for Florida Realtors, including transaction guides, checklists, templates, calculators, AI prompts, automation resources, and real estate classes.";
    } else if (slug.startsWith('resources/free-guides-downloads/') || slug.startsWith('free-guides-downloads/')) {
      const resourceSlug = slug.split('/').pop() || '';
      const matchedResource = getResourceBySlug(resourceSlug);
      if (matchedResource) {
        title = matchedResource.seoTitle || `${matchedResource.title} | Hometown TC`;
        description = matchedResource.seoDescription || matchedResource.shortDescription;
      }
    }

    return {
      params: { slug },
      props: { title, description }
    };
  });
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <App client:load />
</Layout>

